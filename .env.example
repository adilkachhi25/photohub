# PhotoHub Backend - Environment Variables Template
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env file to version control!

# ==================== SERVER CONFIGURATION ====================
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000

# ==================== JWT CONFIGURATION ====================
JWT_SECRET=your-super-secret-key-change-this-min-32-chars
JWT_EXPIRY=7d

# ==================== EMAIL SERVICE ====================
# Choose one: gmail, sendgrid, aws-ses

# Gmail Configuration
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
# Generate app password at: https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=your-16-char-app-password

# SendGrid Configuration (Alternative)
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# AWS SES Configuration (Alternative)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...

# ==================== DATABASE ====================
# MongoDB (Optional, for user persistence)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/photohub

# PostgreSQL (Alternative)
# DATABASE_URL=postgresql://user:password@localhost:5432/photohub

# ==================== BACKGROUND REMOVAL API ====================
# Choose one of the following:

# Option 1: Remove.bg (Free tier: 50 calls/month)
REMOVE_BG_API_KEY=your-remove-bg-api-key

# Option 2: Cloudinary (Better for production)
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
# CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# Option 3: OpenAI Vision API (For advanced processing)
# OPENAI_API_KEY=sk-...

# ==================== RATE LIMITING ====================
# OTP Rate Limiting (requests per 15 minutes)
RATE_LIMIT_OTP_MAX=5

# General API Rate Limiting (requests per 15 minutes)
RATE_LIMIT_GENERAL_MAX=100

# ==================== LOGGING ====================
# LOG_LEVEL=info
# LOG_FILE=./logs/app.log

# ==================== ERROR TRACKING (Optional) ====================
# Sentry Configuration
# SENTRY_DSN=https://key@sentry.io/project-id

# ==================== SECURITY ====================
# HTTPS Configuration
# SSL_KEY_PATH=./certs/key.pem
# SSL_CERT_PATH=./certs/cert.pem

# ==================== OPTIONAL FEATURES ====================
# Image Optimization
ENABLE_IMAGE_OPTIMIZATION=true
MAX_IMAGE_SIZE=10485760  # 10MB in bytes

# Email Verification (Send real emails if true)
SEND_REAL_EMAILS=false

# Debug Mode
DEBUG=false
VERBOSE_LOGGING=false

# ==================== THIRD-PARTY SERVICES ====================
# Analytics
# GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# Error Tracking
# BUGSNAG_API_KEY=...

# ==================== FRONTEND ====================
# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:3000
FRONTEND_PRODUCTION_URL=https://yourdomain.com

# ==================== OTP CONFIGURATION ====================
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3

# ==================== SESSION ====================
# Session timeout in hours
SESSION_TIMEOUT=24

# ==================== DEPLOYMENT ====================
# Vercel, Heroku, or custom deployment
# DEPLOYMENT_ENV=development
# DEPLOYMENT_PLATFORM=local

# ==================== NOTES ====================
# 1. Generate JWT_SECRET with:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# 2. Generate Gmail App Password at:
#    https://myaccount.google.com/apppasswords
#
# 3. Get Remove.bg API key at:
#    https://www.remove.bg/api
#
# 4. Never commit this file to version control
#
# 5. Keep all sensitive values secret and use environment variables in production
#
# 6. For production deployment, use a secrets management service:
#    - AWS Secrets Manager
#    - Azure Key Vault
#    - HashiCorp Vault
#    - Vercel Secrets
#    - Railway Vault
